.DS_Store

# Keep C++ source and header files; ignore generated files in the C++ folder.
/C++/**
!/C++/**/
!/C++/**/*.c
!/C++/**/*.cc
!/C++/**/*.cpp
!/C++/**/*.c++
!/C++/**/*.cxx
!/C++/**/*.C
!/C++/**/*.h
!/C++/**/*.hh
!/C++/**/*.hpp
!/C++/**/*.hxx
!/C++/**/*.md
!/C++/**/*.png
!/C++/**/*.jpg
!/C++/**/*.jpeg
!/C++/**/*.gif
!/C++/**/*.svg
*.exe
*.out
